# cbkConfig.cmake -- find_package(cbk CONFIG) for an installed cbk.
#
# Imported target:
#   cbk::cbk       the library: the portable C API (cbk.h, no BLAS)
#                  and, when cbk was installed with CBK_WITH_MKL=ON, the
#                  MKL-style API too (cbk_compat.h, cbk_mkl_alloc.h)
#
# Variables:
#   cbk_FOUND, cbk_VERSION
#   cbk_WITH_MKL   whether the MKL-style API (and the MKL headers) are installed
#   cbk_MKL_INTERFACE  the MKL integer interface cbk was built with, lp64 or
#                  ilp64: part of its ABI (MKL_INT in every prototype), so
#                  the consumer's MKLCompact_INTERFACE has to match
#
# Assisted-by: Claude:claude-fable-5

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(cbk_WITH_MKL @CBK_WITH_MKL@)
set(cbk_MKL_INTERFACE "@MKLCompact_INTERFACE@")

# A static cbk built with OpenMP exports the runtime as a link-only dependency
# of cbk::cbk, so OpenMP::OpenMP_CXX has to exist here (the consumer needs the
# CXX language enabled, as it does anyway to link a C++ static library).
if(@CBK_OPENMP_LINK_ONLY@)
  find_dependency(OpenMP COMPONENTS CXX)
endif()

# With the MKL-style API, cbk::cbk uses MKL's types but no MKL link line, so
# only the headers are re-found, with the find module installed beside this
# file; its interface default is seeded to cbk's, and an override that
# disagrees is refused (it would compile cbk's prototypes for the wrong
# MKL_INT). A consumer that calls MKL itself finds MKL::Compact with that
# module (list(APPEND CMAKE_MODULE_PATH "${cbk_DIR}")) or with its own.
if(cbk_WITH_MKL)
  set(MKLCompact_INTERFACE "${cbk_MKL_INTERFACE}" CACHE STRING
      "MKL integer interface: lp64 | ilp64")
  set(_cbk_module_path "${CMAKE_MODULE_PATH}")
  list(INSERT CMAKE_MODULE_PATH 0 "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(MKLCompact COMPONENTS Headers)
  set(CMAKE_MODULE_PATH "${_cbk_module_path}")
  if(NOT MKLCompact_INTERFACE STREQUAL cbk_MKL_INTERFACE)
    message(FATAL_ERROR "cbk was built with MKLCompact_INTERFACE=${cbk_MKL_INTERFACE}; "
                        "this project uses ${MKLCompact_INTERFACE}")
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cbkTargets.cmake")

check_required_components(cbk)
