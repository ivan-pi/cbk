! cqr_mkl_ext.fi -- Fortran interfaces for the MKL-style API of
! cqr_mkl_ext.h: batched QR, Cholesky, unpivoted LDL^T, triangular
! solve and least-squares solve for matrices in Intel MKL's Compact
! format, backed by this project's portable SIMD kernels.
!
! INCLUDE this file (once) in the specification part of each program
! unit that calls the routines:
!
!       implicit none
!       include 'cqr_mkl_ext.fi'
!
! The file reads identically as fixed-form and free-form source; the
! column conventions are documented in cqr_compact.fi (statements in
! columns 7-72, '&' in column 73 continued by '&' in column 6 -- keep
! those columns when editing, and compile fixed-form includers at the
! standard 72-column line length).
!
! MKL_LAYOUT / MKL_UPLO / MKL_SIDE / MKL_TRANSPOSE / MKL_DIAG /
! MKL_COMPACT_PACK arguments are C enums: integer(c_int) dummies here,
! with the enumerators below transcribed from MKL's mkl_types.h
! (identical in MKL 2020.0.4 and oneMKL 2026.1). MKL_INT arguments and
! info are integer(c_int): the LP64 interface, the library's default
! build (-DMKLCompact_INTERFACE=lp64). Against an ILP64 build of the
! library (-DMKLCompact_INTERFACE=ilp64, MKL_INT a 64-bit integer)
! include cqr_mkl_ext_ilp64.fi INSTEAD of this file -- same routines
! with MKL_INT arguments and info integer(c_long_long); the enums stay
! integer(c_int) either way (a C enum does not widen under ILP64).
! Guarding that choice is the includer's job, as with MKL's own
! _lp64/_ilp64 interface files. side/trans option flags that are plain
! C char stay single characters passed by value.
!
! Each d/s pair is grouped under a precision-generic name as well
! (cqr_mkl_geqrf_compact, ...): the kind of the real actual arguments
! selects the specific. As in cqr_compact.fi (which carries the full
! rationale), the generics need rank-1 actuals -- a flat buffer, or a
! rank-1 pointer view, p(1:size(a)) => a -- while a call to a
! specific name accepts any rank by sequence association.
!
! Like MKL's own compact routines these skip argument checking, and
! info is a scalar output: 0 on success, -1 for an unrecognized
! format. Size each routine's work from its own lwork = -1 query and
! give each routine its own buffer -- lwork is never checked, so an
! undersized or shared work array is a silent overrun (cqr_mkl_ext.h
! documents the workspace contract; ?gels's work is its tau scratch
! and holds tau on exit).

! The MKL_LAYOUT / MKL_UPLO / MKL_SIDE / MKL_TRANSPOSE / MKL_DIAG /
! MKL_COMPACT_PACK enumerators, transcribed from mkl_types.h once for
! this file and its ILP64 twin (enums stay int-sized either way):
      include 'cqr_mkl_enums.fi'


! QR factorization: ap -> (R, Householder vectors), taup -> tau
      interface cqr_mkl_geqrf_compact
      subroutine cqr_mkl_dgeqrf_compact(layout, m, n, ap, ldap, taup,   &
     &    work, lwork, info, format, nm)                                &
     &    bind(c, name='cqr_mkl_dgeqrf_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_double
      implicit none
      integer(c_int), value :: layout, m, n, ldap, lwork, format, nm
      real(c_double), intent(inout) :: ap(*), work(*)
      real(c_double), intent(out) :: taup(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_dgeqrf_compact

      subroutine cqr_mkl_sgeqrf_compact(layout, m, n, ap, ldap, taup,   &
     &    work, lwork, info, format, nm)                                &
     &    bind(c, name='cqr_mkl_sgeqrf_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_float
      implicit none
      integer(c_int), value :: layout, m, n, ldap, lwork, format, nm
      real(c_float), intent(inout) :: ap(*), work(*)
      real(c_float), intent(out) :: taup(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_sgeqrf_compact
      end interface cqr_mkl_geqrf_compact

! cp := op(Q) cp (side 'L') or cp op(Q) (side 'R')
      interface cqr_mkl_ormqr_compact
      subroutine cqr_mkl_dormqr_compact(layout, side, trans, m, n, k,   &
     &    ap, ldap, taup, cp, ldcp, work, lwork, info, format, nm)      &
     &    bind(c, name='cqr_mkl_dormqr_compact')
      use, intrinsic :: iso_c_binding, only: c_char, c_int, c_double
      implicit none
      integer(c_int), value :: layout, m, n, k, ldap, ldcp, lwork
      integer(c_int), value :: format, nm
      character(kind=c_char), value :: side, trans
      real(c_double), intent(in) :: ap(*), taup(*)
      real(c_double), intent(inout) :: cp(*), work(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_dormqr_compact

      subroutine cqr_mkl_sormqr_compact(layout, side, trans, m, n, k,   &
     &    ap, ldap, taup, cp, ldcp, work, lwork, info, format, nm)      &
     &    bind(c, name='cqr_mkl_sormqr_compact')
      use, intrinsic :: iso_c_binding, only: c_char, c_int, c_float
      implicit none
      integer(c_int), value :: layout, m, n, k, ldap, ldcp, lwork
      integer(c_int), value :: format, nm
      character(kind=c_char), value :: side, trans
      real(c_float), intent(in) :: ap(*), taup(*)
      real(c_float), intent(inout) :: cp(*), work(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_sormqr_compact
      end interface cqr_mkl_ormqr_compact

! Cholesky factorization of an SPD batch: A = L L^T or U^T U
      interface cqr_mkl_potrf_compact
      subroutine cqr_mkl_dpotrf_compact(layout, uplo, n, ap, ldap,      &
     &    info, format, nm) bind(c, name='cqr_mkl_dpotrf_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_double
      implicit none
      integer(c_int), value :: layout, uplo, n, ldap, format, nm
      real(c_double), intent(inout) :: ap(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_dpotrf_compact

      subroutine cqr_mkl_spotrf_compact(layout, uplo, n, ap, ldap,      &
     &    info, format, nm) bind(c, name='cqr_mkl_spotrf_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_float
      implicit none
      integer(c_int), value :: layout, uplo, n, ldap, format, nm
      real(c_float), intent(inout) :: ap(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_spotrf_compact
      end interface cqr_mkl_potrf_compact

! Unpivoted LDL^T: A = L D L^T (MKL_LOWER) or U^T D U (MKL_UPPER)
      interface cqr_mkl_sytrfnp_compact
      subroutine cqr_mkl_dsytrfnp_compact(layout, uplo, n, ap, ldap,    &
     &    info, format, nm) bind(c, name='cqr_mkl_dsytrfnp_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_double
      implicit none
      integer(c_int), value :: layout, uplo, n, ldap, format, nm
      real(c_double), intent(inout) :: ap(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_dsytrfnp_compact

      subroutine cqr_mkl_ssytrfnp_compact(layout, uplo, n, ap, ldap,    &
     &    info, format, nm) bind(c, name='cqr_mkl_ssytrfnp_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_float
      implicit none
      integer(c_int), value :: layout, uplo, n, ldap, format, nm
      real(c_float), intent(inout) :: ap(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_ssytrfnp_compact
      end interface cqr_mkl_sytrfnp_compact

! Solve A X = B from the ?sytrfnp_compact factor: bp := X
      interface cqr_mkl_sytrsnp_compact
      subroutine cqr_mkl_dsytrsnp_compact(layout, uplo, n, nrhs, ap,    &
     &    ldap, bp, ldbp, info, format, nm)                             &
     &    bind(c, name='cqr_mkl_dsytrsnp_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_double
      implicit none
      integer(c_int), value :: layout, uplo, n, nrhs, ldap, ldbp
      integer(c_int), value :: format, nm
      real(c_double), intent(in) :: ap(*)
      real(c_double), intent(inout) :: bp(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_dsytrsnp_compact

      subroutine cqr_mkl_ssytrsnp_compact(layout, uplo, n, nrhs, ap,    &
     &    ldap, bp, ldbp, info, format, nm)                             &
     &    bind(c, name='cqr_mkl_ssytrsnp_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_float
      implicit none
      integer(c_int), value :: layout, uplo, n, nrhs, ldap, ldbp
      integer(c_int), value :: format, nm
      real(c_float), intent(in) :: ap(*)
      real(c_float), intent(inout) :: bp(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_ssytrsnp_compact
      end interface cqr_mkl_sytrsnp_compact

! Symmetric solve in one pass: ap -> (D, L|U) factor, bp := X
      interface cqr_mkl_sysvnp_compact
      subroutine cqr_mkl_dsysvnp_compact(layout, uplo, n, nrhs, ap,     &
     &    ldap, bp, ldbp, info, format, nm)                             &
     &    bind(c, name='cqr_mkl_dsysvnp_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_double
      implicit none
      integer(c_int), value :: layout, uplo, n, nrhs, ldap, ldbp
      integer(c_int), value :: format, nm
      real(c_double), intent(inout) :: ap(*), bp(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_dsysvnp_compact

      subroutine cqr_mkl_ssysvnp_compact(layout, uplo, n, nrhs, ap,     &
     &    ldap, bp, ldbp, info, format, nm)                             &
     &    bind(c, name='cqr_mkl_ssysvnp_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_float
      implicit none
      integer(c_int), value :: layout, uplo, n, nrhs, ldap, ldbp
      integer(c_int), value :: format, nm
      real(c_float), intent(inout) :: ap(*), bp(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_ssysvnp_compact
      end interface cqr_mkl_sysvnp_compact

! Triangular solve: op(A) X = alpha B (MKL_LEFT) or X op(A) = alpha B
      interface cqr_mkl_trsm_compact
      subroutine cqr_mkl_dtrsm_compact(layout, side, uplo, transa,      &
     &    diag, m, n, alpha, ap, ldap, bp, ldbp, format, nm)            &
     &    bind(c, name='cqr_mkl_dtrsm_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_double
      implicit none
      integer(c_int), value :: layout, side, uplo, transa, diag
      integer(c_int), value :: m, n, ldap, ldbp, format, nm
      real(c_double), value :: alpha
      real(c_double), intent(in) :: ap(*)
      real(c_double), intent(inout) :: bp(*)
      end subroutine cqr_mkl_dtrsm_compact

      subroutine cqr_mkl_strsm_compact(layout, side, uplo, transa,      &
     &    diag, m, n, alpha, ap, ldap, bp, ldbp, format, nm)            &
     &    bind(c, name='cqr_mkl_strsm_compact')
      use, intrinsic :: iso_c_binding, only: c_int, c_float
      implicit none
      integer(c_int), value :: layout, side, uplo, transa, diag
      integer(c_int), value :: m, n, ldap, ldbp, format, nm
      real(c_float), value :: alpha
      real(c_float), intent(in) :: ap(*)
      real(c_float), intent(inout) :: bp(*)
      end subroutine cqr_mkl_strsm_compact
      end interface cqr_mkl_trsm_compact

! Least-squares / minimum-norm solve op(A) X = B: ap -> QR|LQ factor,
! bp rows 1..n -> X, work -> tau (its lwork = -1 query sizes it)
      interface cqr_mkl_gels_compact
      subroutine cqr_mkl_dgels_compact(layout, trans, m, n, nrhs, ap,   &
     &    ldap, bp, ldbp, work, lwork, info, format, nm)                &
     &    bind(c, name='cqr_mkl_dgels_compact')
      use, intrinsic :: iso_c_binding, only: c_char, c_int, c_double
      implicit none
      integer(c_int), value :: layout, m, n, nrhs, ldap, ldbp, lwork
      integer(c_int), value :: format, nm
      character(kind=c_char), value :: trans
      real(c_double), intent(inout) :: ap(*), bp(*), work(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_dgels_compact

      subroutine cqr_mkl_sgels_compact(layout, trans, m, n, nrhs, ap,   &
     &    ldap, bp, ldbp, work, lwork, info, format, nm)                &
     &    bind(c, name='cqr_mkl_sgels_compact')
      use, intrinsic :: iso_c_binding, only: c_char, c_int, c_float
      implicit none
      integer(c_int), value :: layout, m, n, nrhs, ldap, ldbp, lwork
      integer(c_int), value :: format, nm
      character(kind=c_char), value :: trans
      real(c_float), intent(inout) :: ap(*), bp(*), work(*)
      integer(c_int), intent(out) :: info
      end subroutine cqr_mkl_sgels_compact
      end interface cqr_mkl_gels_compact
